# Optional — enables Google sign-in + cross-device sync (see docs/DEPLOY.md). Leave unset for a local-only build.
# Both URLs are shown in the Neon Console: Auth URL (Neon Auth tab) and Data API URL (Data API tab).
VITE_NEON_AUTH_URL=https://ep-xxx.neonauth.<region>.aws.neon.tech/neondb/auth
VITE_NEON_DATA_API_URL=https://ep-xxx.apirest.<region>.aws.neon.tech/neondb/rest/v1
